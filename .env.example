# Copia este fichero a `.env` y rellena los valores.
#   cp .env.example .env
#
# `.env` está en .gitignore y en .dockerignore: nunca se versiona ni entra en
# la imagen de Docker.

# --- Base de datos ---------------------------------------------------------
# En desarrollo, estas tres las consume el contenedor `db` (docker-compose.
# override.yml) para crear la base al arrancar por primera vez.
#
# En producción NO hay contenedor `db` propio: FinanzApp usa el Postgres
# compartido del VPS (entramaes-infra/postgres), así que el usuario y la base
# `finanzapp` tienen que existir ya ahí antes de desplegar — no se crean
# solos. Para crearlos (una sola vez, desde el VPS):
#   docker compose -f /opt/entramaes/infra/postgres/docker-compose.yml \
#     exec postgres psql -U entramaes -c \
#     "CREATE USER finanzapp WITH PASSWORD 'la-misma-que-pongas-abajo';
#      CREATE DATABASE finanzapp OWNER finanzapp;"
POSTGRES_USER=finanzapp
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=finanzapp

# Cadena de conexión que usa la aplicación.
#
# El valor de aquí es el de HOST: sirve para ejecutar alembic o uvicorn desde
# el venv local, y por eso apunta a localhost:5433 (el puerto que el
# docker-compose.override.yml publica en desarrollo).
#
# Dentro de Docker NO se usa este valor: docker-compose.yml lo sobrescribe.
# En desarrollo apunta a postgresql://...@db:5432/..., el contenedor local;
# en producción a postgresql://...@postgres:5432/..., el Postgres compartido
# del VPS (mismo nombre de red `web`, distinto host).
DATABASE_URL=postgresql://finanzapp:cambia-esto@localhost:5433/finanzapp

# --- Autenticación ---------------------------------------------------------
# Clave de firma de los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=genera-una-clave-aleatoria
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Credenciales OAuth 2.0 de Google. Opcionales mientras no se implemente el
# login con Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Aplicación ------------------------------------------------------------
# Orígenes permitidos para CORS, separados por comas — el origen exacto del
# frontend (esquema + host + puerto), nunca "*": los tokens de sesión viajan
# en cookies, y un navegador rechaza "*" en cuanto se permiten credenciales
# (ver ARCHITECTURE.md §5.7). Ajusta el puerto al que use tu frontend. En
# producción es obligatorio y cada origen debe ser HTTPS exacto, sin ruta.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# development | production
ENVIRONMENT=development
